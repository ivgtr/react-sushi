{
  "name": "react-sushi",
  "description": "🍣 react sushi component",
  "license": "MIT",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivgtr/react-sushi.git"
  },
  "author": {
    "name": "ivgtr",
    "email": "ivgtr.me@gmail.com",
    "url": "https://github.com/ivgtr"
  },
  "bugs": {
    "url": "https://github.com/ivgtr/react-sushi/issues"
  },
  "homepage": "https://github.com/ivgtr/react-sushi#readme",
  "main": "./dist/react-sushi.umd.js",
  "module": "./dist/react-sushi.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-sushi.es.js",
      "require": "./dist/react-sushi.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "component",
    "sushi"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e 'fs.rmSync(`dist`, {recursive:true, force:true})'",
    "prebuild:docs": "node -e 'fs.rmSync(`docs`, {recursive:true, force:true})'",
    "build": "vite build && tsc --emitDeclarationOnly",
    "build:docs": "vite build -c vite.docs.config.ts",
    "format": "prettier -w \"./src/**/*.{js,jsx,ts,tsx,css}\"",
    "lint": "node scripts/test-minimatch-compat.cjs && cross-env ESLINT_USE_FLAT_CONFIG=false eslint ./src/**/*.tsx",
    "lint:styles": "stylelint src/styles.scss && prettier --check src/styles.scss",
    "test:compat": "node scripts/test-minimatch-compat.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^17.0.30",
    "@types/react-dom": "^17.0.9",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^2.4.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "sass": "^1.43.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-scss": "^7.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.2",
    "react-dom": "^16.8.0 || ^17.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "minimatch": "file:vendor/minimatch-compat"
  }
}
