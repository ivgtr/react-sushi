{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-recess-order"
  ],
  "plugins": [
    "stylelint-scss",
    "stylelint-order"
  ],
  "rules": {
    "order/order": [
      [
        "dollar-variables",
        "declarations",
        "rules"
      ]
    ],
    "color-hex-length": "short",
    "no-descending-specificity": null,
    "at-rule-no-unknown": null,
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "layer",
          "variants"
        ]
      }
    ]
  },
  "customSyntax": "postcss-scss"
}
